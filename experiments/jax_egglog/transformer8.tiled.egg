
;; Auto-generated HLO -> egglog datatype.

(datatype Hlo
  (HParam String)
  (HConst String)

  ;; element-wise unary
  (HNeg Hlo)
  (HAbs Hlo)
  (HExp Hlo)
  (HLog Hlo)
  (HSqrt Hlo)
  (HRsqrt Hlo)
  (HTanh Hlo)
  (HSigmoid Hlo)
  (HRelu Hlo)
  (HCopy Hlo)
  (HConvert Hlo String)

  ;; element-wise binary
  (HAdd Hlo Hlo)
  (HSub Hlo Hlo)
  (HMul Hlo Hlo)
  (HDiv Hlo Hlo)
  (HMax Hlo Hlo)
  (HMin Hlo Hlo)
  (HPow Hlo Hlo)
  (HCompare Hlo Hlo String)

  ;; ternary
  (HSelect Hlo Hlo Hlo)

  ;; data movement
  (HTranspose Hlo String)
  (HReshape Hlo String)
  (HBroadcast Hlo String)
  (HSlice Hlo String)
  (HConcat Hlo Hlo String)
  (HPad Hlo Hlo String)
  (HReverse Hlo String)

  ;; linear algebra
  (HDot Hlo Hlo String)
  (HConv Hlo Hlo String)

  ;; reductions (input, init, dims-tag)
  (HReduceSum Hlo Hlo String)
  (HReduceMax Hlo Hlo String)
  (HReduceMin Hlo Hlo String)
  (HReduceProd Hlo Hlo String)

  (HIota String String)

  ;; generic fallback for opcodes the bridge doesn't model individually
  (HOp1 String Hlo)
  (HOp2 String Hlo Hlo)
  (HOp3 String Hlo Hlo Hlo)
  (HOp4 String Hlo Hlo Hlo Hlo)
  (HOp5 String Hlo Hlo Hlo Hlo Hlo)
  ;; ----- flow_prune injected tiled targets -----
  (TiledHDot  Hlo Hlo String i64)
  (TiledHConv Hlo Hlo String i64)
)
